# Copy the relevant entries into .env.local and your deployment's secret settings.
# Never prefix credentials with NEXT_PUBLIC_. Do not commit real secrets.

# NEON OBJECT STORAGE — create a PRIVATE bucket on the same branch as DATABASE_URL.
# Copy these AWS-standard values from Neon > Branch > Credentials.
# The credential needs storage:read and storage:write.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STUDIO_STORAGE_BUCKET=standex-studio

# CREATIVE REVIEW — dedicated Azure OpenAI resource/deployment (optional).
# Resource endpoint, e.g. https://your-resource.openai.azure.com
# Deploy an image-capable chat model; use its DEPLOYMENT name below.
# These settings do not change Writing Lab or the existing text-model settings.
AZURE_OPENAI_VISION_ENDPOINT=
AZURE_OPENAI_VISION_API_KEY=
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_VISION_API_VERSION=2024-10-21

# If the dedicated Azure settings are all empty, creative reviews use the existing
# OPENAI_API_KEY / OPENAI_MODEL or AZURE_OPENAI_* chat configuration instead.
# Optional model override when using the existing standard OpenAI API provider:
MARKETING_VISION_MODEL=

# OCR / TAGS / OBJECT BOXES — optional separate Azure AI Vision resource.
# Resource endpoint, e.g. https://your-vision-resource.cognitiveservices.azure.com
# This is a different service from Azure OpenAI; its keys are not interchangeable.
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_KEY=
AZURE_AI_VISION_API_VERSION=2024-02-01
