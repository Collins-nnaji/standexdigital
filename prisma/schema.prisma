generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StandexEnquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  enquiryType String
  message     String   @db.Text
  createdAt   DateTime @default(now())

  @@map("standex_enquiry")
  @@index([email])
  @@index([createdAt(sort: Desc)])
}
